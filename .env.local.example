# Copie este arquivo para .env.local e preencha os valores necessários.
# NUNCA commite .env.local no repositório.

# Opcional: ID de métricas do Google Analytics 4 (formato G-XXXXXXXXXX).
# Se não definida, nenhum script de analytics é carregado no site.
NEXT_PUBLIC_GA_ID=

# Opcional: usadas por scripts/sync-analytics.mjs (Node, roda em build-time/CI)
# para buscar métricas na GA4 Data API e alimentar o card de Analytics do
# dashboard admin. GA_PROPERTY_ID é o ID numérico da propriedade GA4
# (Admin → Detalhes da propriedade). GA_SERVICE_ACCOUNT_KEY é o conteúdo do
# JSON da service account (Google Cloud → IAM → Contas de serviço → Chaves),
# em uma única linha, com essa conta adicionada como "Leitor" na propriedade
# GA4 (Admin → Acesso à propriedade). Se não definidas, o dashboard mostra o
# snapshot de exemplo já versionado em src/content/analytics.json.
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_KEY=

# Login do painel administrativo via GitHub OAuth Device Flow. Qualquer
# colaborador do repositório com permissão de escrita consegue entrar.
#
# Passo a passo:
# 1. Crie um OAuth App em https://github.com/settings/applications/new
#    (a "Homepage URL" pode ser a URL do site) e HABILITE o Device Flow nas
#    configurações do app.
# 2. NEXT_PUBLIC_GH_OAUTH_CLIENT_ID = Client ID gerado no passo 1.
# 3. Publique o proxy stateless em cloudflare/github-oauth-proxy/ (ver o
#    README naquela pasta) e use a URL publicada abaixo — o Device Flow não
#    suporta CORS direto do navegador, por isso o proxy é necessário.
NEXT_PUBLIC_GH_OWNER=
NEXT_PUBLIC_GH_REPO=
NEXT_PUBLIC_GH_BRANCH=main
NEXT_PUBLIC_GH_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GH_OAUTH_PROXY_URL=
