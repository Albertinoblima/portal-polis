# Copie este arquivo para .env.local e preencha com as credenciais do seu
# projeto Supabase (Project Settings → API). NUNCA commite .env.local nem a
# service_role key em lugar nenhum do repositório.

# Usadas pelo navegador (painel administrativo) — prefixo NEXT_PUBLIC_
# obrigatório para o Next.js expor a variável ao client bundle.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Usadas por scripts/sync-content.mjs (Node, roda em build-time/CI — mesmos
# valores acima, sem o prefixo NEXT_PUBLIC_).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: ID de métricas do Google Analytics 4 (formato G-XXXXXXXXXX).
# Se não definida, nenhum script de analytics é carregado no site.
NEXT_PUBLIC_GA_ID=

# Opcional: usadas por scripts/sync-analytics.mjs (Node, roda em build-time/CI)
# para buscar métricas na GA4 Data API e alimentar o card de Analytics do
# dashboard admin. GA_PROPERTY_ID é o ID numérico da propriedade GA4
# (Admin → Detalhes da propriedade). GA_SERVICE_ACCOUNT_KEY é o conteúdo do
# JSON da service account (Google Cloud → IAM → Contas de serviço → Chaves),
# em uma única linha, com essa conta adicionada como "Leitor" na propriedade
# GA4 (Admin → Acesso à propriedade). Se não definidas, o dashboard mostra o
# snapshot de exemplo já versionado em src/content/analytics.json.
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_KEY=
